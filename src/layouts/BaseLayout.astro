---
const { title = "Feri Ferdianto" } = Astro.props;
import '../styles/global.css';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/projects', label: 'Projek' },
  { href: '/certificates', label: 'Sertifikat' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Hubungi' },
];
---
<!DOCTYPE html>
<html lang="id" data-theme="cupcake">
<head>
    <style is:inline>
    /* TEMA CUPCAKE (LIGHT) */
    :root {
      --bg-main: #faf7f5;       /* Warna dasar cream Cupcake */
      --bg-card: #ffffff;       /* Warna card putih bersih */
      --bg-secondary: #f2f2f2;  /* Warna abu-abu terang untuk hover/box */
      --text-main: #291334;     /* Warna teks ungu gelap khas Cupcake */
      --text-muted: #6b7280;    /* Warna teks abu-abu */
      --border-color: #e5e7eb;  /* Warna border tipis */
    }

    /* TEMA DARK */
    .dark {
      --bg-main: #0a0a0a;       /* Latar belakang hitam (neutral-950) */
      --bg-card: #171717;       /* Latar card (neutral-900) */
      --bg-secondary: #262626;  /* Hover (neutral-800) */
      --text-main: #f5f5f5;     /* Teks putih */
      --text-muted: #a3a3a3;    /* Teks abu-abu */
      --border-color: #262626;  /* Border gelap */
    }

    /* Terapkan secara otomatis ke seluruh body */
    body {
      background-color: var(--bg-main) !important;
      color: var(--text-main) !important;
    }

    /* Trik agar class bg-white, dark:bg-neutral-900, border-neutral-200, dll otomatis berubah warna */
    .bg-white { background-color: var(--bg-card) !important; }
    .dark\:bg-neutral-900 { background-color: var(--bg-card) !important; }
    .bg-neutral-50 { background-color: var(--bg-secondary) !important; }
    .dark\:bg-neutral-950 { background-color: var(--bg-main) !important; }
    .bg-neutral-100 { background-color: var(--bg-secondary) !important; }
    .dark\:bg-neutral-800 { background-color: var(--bg-secondary) !important; }
    
    .border-neutral-200 { border-color: var(--border-color) !important; }
    .dark\:border-neutral-800 { border-color: var(--border-color) !important; }
    .border-neutral-300 { border-color: var(--border-color) !important; }
    .dark\:border-neutral-700 { border-color: var(--border-color) !important; }

    .text-neutral-900 { color: var(--text-main) !important; }
    .dark\:text-neutral-100 { color: var(--text-main) !important; }
    .text-neutral-500 { color: var(--text-muted) !important; }
    .dark\:text-neutral-400 { color: var(--text-muted) !important; }
    .text-neutral-600 { color: var(--text-muted) !important; }
  </style>
    <!-- SEO & Open Graph -->
  <meta name="description" content="Portofolio - Feri Ferdianto" />
  
  <meta property="og:type" content="website">
  <meta property="og:title" content="Feri Ferdianto — Aspiring Software Engineer">
  <meta property="og:description" content="Portofolio Feri Ferdianto. Berisi projek web development, studi kasus teknis, dan dokumentasi proses belajar — dari eksperimen hingga proyek nyata.">
  <link rel="canonical" href="https://ferrcodes.github.io/Portofolio/">
  <meta property="og:image" content="https://raw.githubusercontent.com/FerrCodes/Portofolio/main/assets/images/me/preview.png">
  <meta property="og:url" content="https://ferrcodes.github.io/Portofolio/">

  <!-- Structured Data (Google) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Feri Ferdianto",
    "jobTitle": "Software Engineer",
    "url": "https://ferrcodes.github.io/Portofolio/",
    "sameAs": [
      "https://github.com/FerrCodes",
      "https://www.instagram.com/imnotferrriii",
      "https://x.com/imnotferrriii"
    ]
  }
  </script>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Feri Ferdianto — Software Engineer">
  <meta name="twitter:description" content="Portofolio Feri Ferdianto, siswa SMKN 5 Malang.">
  <meta name="twitter:image" content="https://raw.githubusercontent.com/FerrCodes/Portofolio/main/assets/images/me/preview.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Feri Ferdianto</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script is:inline>
    const theme = localStorage.getItem('theme');
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'cupcake');
    }
  </script>
</head>
<body class="font-body antialiased">
  <div class="flex min-h-screen">
    <aside class="hidden md:flex flex-col justify-between w-64 border-r border-neutral-200 dark:border-neutral-800 p-6 sticky top-0 h-screen">
      <div>
        <img src="/Portofolio/assets/images/me/favicon.png" alt="Feri" class="w-28 h-28 rounded-full object-cover mx-auto mb-20 mt-9 border border-neutral-200 dark:border-neutral-700" />
          <nav class="flex flex-col gap-1">
          {navItems.map(item => {
            // Cek apakah URL saat ini sama dengan menu yang sedang di-loop
            const isActive = currentPath === `/Portofolio${item.href}` || (item.href !== '/' && currentPath.startsWith(`/Portofolio${item.href}`));
            return (
              <a 
                href={`/Portofolio${item.href}`} 
                class={`px-3 py-2 rounded-md text-sm transition-colors ${
                  isActive 
                    ? 'bg-purple-100 text-purple-900 dark:bg-purple-900/30 dark:text-purple-300 font-bold'
                    : 'hover:bg-neutral-100 dark:hover:bg-neutral-800'
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
      <div class="flex justify-center gap-5 text-2xl text-neutral-600 dark:text-neutral-400">
        <a href="https://github.com/FerrCodes" target="_blank" class="hover:text-black dark:hover:text-white"><i class="fab fa-github"></i></a>
        <a href="https://www.instagram.com/imnotferrriii" target="_blank" class="hover:text-pink-600"><i class="fab fa-instagram"></i></a>
        <a href="https://x.com/imnotferrriii" target="_blank" class="hover:text-blue-400"><i class="fab fa-twitter"></i></a>
      </div>
    </aside>

    <!-- MOBILE DRAWER OVERLAY -->
    <div id="mobile-drawer-overlay" class="fixed inset-0 bg-black/50 z-40 hidden opacity-0 transition-opacity duration-300 md:hidden"></div>

    <!-- MOBILE DRAWER MENU -->
    <div id="mobile-drawer" class="fixed top-0 left-0 h-full w-64 bg-white dark:bg-neutral-950 border-r border-neutral-200 dark:border-neutral-800 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col p-6 shadow-2xl">
      <div class="flex justify-end mb-4">
        <button id="mobile-close-btn" class="text-neutral-500 hover:text-black dark:hover:text-white">
        </button>
      </div>
      
      <!-- Foto & Nama di dalam Drawer -->
      <div class="text-center mb-6">
        <img src="/Portofolio/assets/images/me/favicon.png" alt="Feri" class="w-20 h-20 rounded-full object-cover mx-auto mb-3 border border-neutral-200 dark:border-neutral-700" />
      </div>

      <!-- Menu Navigasi Mobile -->
      <nav class="flex flex-col gap-1 flex-1">
        {navItems.map(item => {
          const isActive = currentPath === `/Portofolio${item.href}` || (item.href !== '/' && currentPath.startsWith(`/Portofolio${item.href}`));
          
          return (
            <a 
              href={`/Portofolio${item.href}`} 
              class={`px-3 py-2 rounded-md text-sm transition-colors ${
                isActive 
                  ? 'bg-purple-100 text-purple-900 dark:bg-purple-900/30 dark:text-purple-300 font-bold'
                  : 'hover:bg-neutral-100 dark:hover:bg-neutral-800'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Sosmed Mobile -->
      <div class="flex justify-center gap-4 text-3xl text-neutral-600 dark:text-neutral-400 mt-auto pt-6 border-t border-neutral-200 dark:border-neutral-800">
        <a href="https://github.com/FerrCodes" target="_blank" class="hover:text-black dark:hover:text-white"><i class="fab fa-github"></i></a>
        <a href="https://www.instagram.com/imnotferrriii" target="_blank" class="hover:text-pink-600"><i class="fab fa-instagram"></i></a>
        <a href="https://x.com/imnotferrriii" target="_blank" class="hover:text-blue-400"><i class="fab fa-twitter"></i></a>
      </div>
    </div>

    <!-- MOBILE HEADER (Tombol Profil) -->
    <div class="md:hidden fixed top-4 left-4 z-40">
      <button id="mobile-menu-btn" class="w-12 h-12 rounded-full overflow-hidden border-[3px] border-slate-500 dark:border-blue-500 shadow-xl ring-2 ring-black/10 dark:ring-white/20 active:scale-95 transition-transform">
        <img src="/Portofolio/assets/images/me/favicon.png" alt="Menu" class="w-full h-full object-cover" />
      </button>
    </div>

   <main class="flex-1 px-6 md:px-12 pt-20 md:pt-10 pb-10 max-w-5xl mx-auto">
      <div class="flex justify-end mb-8">
        <button id="theme-toggle" class="flex items-center gap-2 text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors">
          <i class="fas fa-moon"></i> Ganti Tema
        </button>
      </div>
      <slot />
    </main>
  </div>

  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.setAttribute('data-theme', 'cupcake');
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });

    // --- LOGIKA MOBILE DRAWER ---
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileCloseBtn = document.getElementById('mobile-close-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const mobileOverlay = document.getElementById('mobile-drawer-overlay');

    function openDrawer() {
      if(mobileOverlay && mobileDrawer) {
        mobileOverlay.classList.remove('hidden');
        // Sedikit delay agar transisi opacity berjalan
        setTimeout(() => mobileOverlay.classList.remove('opacity-0'), 10);
        mobileDrawer.classList.remove('-translate-x-full');
        document.body.style.overflow = 'hidden'; // Cegah scroll di background
      }
    }

    function closeDrawer() {
      if(mobileOverlay && mobileDrawer) {
        mobileOverlay.classList.add('opacity-0');
        mobileDrawer.classList.add('-translate-x-full');
        document.body.style.overflow = '';
        setTimeout(() => mobileOverlay.classList.add('hidden'), 300);
      }
    }

    mobileMenuBtn?.addEventListener('click', openDrawer);
    mobileCloseBtn?.addEventListener('click', closeDrawer);
    mobileOverlay?.addEventListener('click', closeDrawer);
  </script>
</body>
</html>