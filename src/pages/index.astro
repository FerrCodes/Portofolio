---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LearningJourney from '../components/LearningJourney.astro';
import FeaturedCard from '../components/FeaturedCard.astro';

const modules = import.meta.glob('../content/projects/*.md', { eager: true });
let projects: any[] = [];

for (const path in modules) {
  const mod: any = modules[path];
  if (mod.frontmatter) {
    const slug = path.split('/').pop()?.replace('.md', '');
    
    // HANYA masukkan projek yang punya 'featured: true' di file .md
    if (mod.frontmatter.featured === true) {
      projects.push({
        slug: slug,
        title: mod.frontmatter.title,
        description: mod.frontmatter.description,
        image: mod.frontmatter.image,
        year: mod.frontmatter.year,
        status: mod.frontmatter.status || "Selesai",
        tech: mod.frontmatter.tech,
        category: mod.frontmatter.category,
        demoUrl: mod.frontmatter.demoUrl || null,
      });
    }
  }
}

// Tidak perlu di-slice(0, 3) lagi karena kita sudah memfilter khusus 'featured'
// Tapi kita urutkan tetap berdasarkan tahun terbaru
projects.sort((a, b) => b.year.localeCompare(a.year));
const featuredProjects = projects; // <--- Ganti nama variabel atau sesuaikan

---
<BaseLayout title="Beranda - Portofolio">
  <!--HERO SECTION -->
  <section class="mb-16">
    <h1 class="font-heading font-black text-4xl md:text-5xl mt-2 leading-tight">
      Feri Ferdianto
    </h1>
    <h2 class="font-heading font-bold text-xl md:text-2xl mt-2">
      Aspiring Software Engineer and Full Stack Developer
    </h2>
    <p class="mt-4 text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
      Selamat Datang di Portofolio saya.
    </p>

    <div class="flex flex-wrap gap-3 mt-6">
      <a href="/Portofolio/contact" class="px-4 py-2 bg-neutral-100 dark:bg-neutral-800 rounded-md font-semibold text-sm hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors">
        Let's connect!
      </a>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="mb-16">
    <h2 class="font-heading font-bold text-2xl mb-6">Projek Unggulan</h2>
    
    <!-- Grid Layout 3 Kolom -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map(project => (
        <FeaturedCard 
          title={project.title}
          description={project.description}
          image={project.image}
          year={project.year}
          tech={project.tech}
          category={project.category}
          slug={project.slug} 
          demoUrl={project.demoUrl}
          status={project.status}
        />
      ))}
    </div>
  </section>
  <LearningJourney />
</BaseLayout>

<script>
  // @ts-ignore
  if (typeof window !== 'undefined' && window.lucide) {
    // @ts-ignore
    window.lucide.createIcons();
  }
</script>