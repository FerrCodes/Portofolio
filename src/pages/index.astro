---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LearningJourney from '../components/LearningJourney.astro';

// Ambil data projek untuk ditampilkan di Beranda (hanya ambil 3)
const modules = import.meta.glob('../content/projects/*.md', { eager: true });
let projects: any[] = [];

for (const path in modules) {
  const mod: any = modules[path];
  if (mod.frontmatter) {
    const slug = path.split('/').pop()?.replace('.md', '');
    projects.push({
      slug: slug,
      title: mod.frontmatter.title,
      description: mod.frontmatter.description,
      image: mod.frontmatter.image,
      year: mod.frontmatter.year,
      tech: mod.frontmatter.tech,
      category: mod.frontmatter.category,
    });
  }
}
// Urutkan dan ambil 2 teratas untuk preview di beranda
projects.sort((a, b) => b.year.localeCompare(a.year));
const featuredProjects = projects.slice(0, 2);

---
<BaseLayout title="Beranda - Portofolio">
  <!--HERO SECTION -->
  <section class="mb-16">
    <h1 class="font-heading font-black text-4xl md:text-5xl mt-2 leading-tight">
      Feri Ferdianto
    </h1>
    <h2 class="font-heading font-bold text-xl md:text-2xl mt-2">
      Aspiring Software Engineer and Full Stack Developer
    </h2>
    <p class="mt-4 text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
      Selamat Datang di Portofolio saya.
    </p>

    <div class="flex flex-wrap gap-3 mt-6">
      <a href="/Portofolio/contact" class="px-4 py-2 bg-neutral-100 dark:bg-neutral-800 rounded-md font-semibold text-sm hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors">
        Let's connect!
      </a>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="mb-16">
    <h2 class="font-heading font-bold text-2xl mb-6">Projek terbaru</h2>
    <div class="flex flex-col gap-4">
      {featuredProjects.map(project => (
        <ProjectCard 
          title={project.title}
          description={project.description}
          image={project.image}
          year={project.year}
          tech={project.tech}
          category={project.category}
          slug={project.slug} 
        />
      ))}
    </div>
    <div class="mt-6">
      <a href="/Portofolio/projects" class="text-sm text-blue-600 hover:underline dark:text-blue-400 font-semibold">
        Lihat semua projek &rarr;
      </a>
    </div>
  </section>
  <LearningJourney />
</BaseLayout>

<script>
  // @ts-ignore
  if (typeof window !== 'undefined' && window.lucide) {
    // @ts-ignore
    window.lucide.createIcons();
  }
</script>