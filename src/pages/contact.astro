---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
---
<BaseLayout title="Hubungi Saya">
  <section>
    
    <!-- Header -->
    <div class="mb-8">
      <h1 class="font-heading font-black text-3xl md:text-4xl">Hubungi Saya</h1>
      <p class="text-neutral-500 mt-2">Punya pertanyaan, ide projek, atau ingin sekadar menyapa? Silakan isi formulir di bawah ini.</p>
    </div>

        <!-- Layout Grid (Desktop: Bersebelahan, Mobile: Ditumpuk) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- 1. KOTAK FORMULIR (Di mobile atas, di desktop kiri) -->
      <div class="order-2 md:order-1 md:col-span-2">
        <div class="p-6 md:p-8 border-2 border-neutral-200 dark:border-neutral-800 rounded-xl bg-white dark:bg-neutral-900">
          <ContactForm client:load />
        </div>
      </div>

      <!-- 2. KOTAK INFO KONTAK (Di mobile bawah, di desktop kanan) -->
      <div class="order-1 md:order-2 md:col-span-1">
        <div class="p-6 border-2 border-neutral-200 dark:border-neutral-800 rounded-xl bg-white dark:bg-neutral-900">
          <h3 class="font-heading font-bold text-lg mb-4">Info Kontak</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6 leading-relaxed">
            Atau hubungi lewat platform lain dibawah ini
          </p>
          <div class="flex flex-col gap-3">
            <a href="mailto:ferdiantoferi1303@gmail.com" class="flex items-center gap-3 text-sm text-neutral-700 dark:text-neutral-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
              <i data-lucide="mail" class="w-4 h-4"></i> ferdiantoferi1303@gmail.com
            </a>
          </div>
        </div>
      </div>

    </div>

  </section>
</BaseLayout>

<script>
  // @ts-ignore
  if (typeof window !== 'undefined' && window.lucide) {
    // @ts-ignore
    window.lucide.createIcons();
  }
</script>