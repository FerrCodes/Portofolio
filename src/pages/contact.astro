---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
---
<BaseLayout title="Hubungi Saya">
  <section class="max-w-3xl mx-auto">
    
    <div class="mb-10 text-center">
      <h1 class="font-heading font-black text-4xl mb-4">Mari Berkolaborasi</h1>
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Punya pertanyaan, ide projek, atau ingin sekadar menyapa? Silakan isi formulir di bawah ini. Saya akan berusaha membalas secepat mungkin.
      </p>
    </div>

    <!-- Form dari React (Astro akan meng-hydrate ini) -->
    <div class="p-6 md:p-8 border-2 border-neutral-200 dark:border-neutral-800 rounded-2xl bg-white dark:bg-neutral-900 shadow-sm">
      <ContactForm client:load />
    </div>

    <!-- Info Kontak Alternatif -->
    <div class="mt-12 text-center">
      <p class="text-sm text-neutral-500 mb-4">Atau hubungi saya langsung melalui:</p>
      <div class="flex justify-center gap-6">
        <a href="mailto:ferdiantoferi1303@gmail.com" class="flex items-center gap-2 text-sm font-semibold hover:text-blue-600 transition-colors">
          Email
        </a>
        <a href="https://github.com/FerrCodes" target="_blank" class="flex items-center gap-2 text-sm font-semibold hover:text-blue-600 transition-colors">
          GitHub
        </a>
        <a href="https://www.instagram.com/imnotferrriii" target="_blank" class="flex items-center gap-2 text-sm font-semibold hover:text-blue-600 transition-colors">
          Instagram
        </a>
      </div>
    </div>

  </section>
</BaseLayout>