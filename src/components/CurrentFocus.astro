---
const focuses = [
  {
    title: "Full-Stack Development",
    desc: "Membangun aplikasi web serta mendalami bagaimana frontend, backend, dan basis data bekerja bersama.",
    icon: "layers"
  },
  {
    title: "Mobile Development",
    desc: "Belajar melalui proyek-proyek praktis Android dan Flutter serta mencoba Kotlin juga.",
    icon: "smartphone"
  },
  {
    title: "System Exploration",
    desc: "Memahami cara kerja aplikasi di balik layar melalui eksperimen.",
    icon: "terminal"
  }
];
---
<section class="mb-16">
  <h2 class="font-heading font-bold text-2xl mb-6 border-b border-neutral-200 dark:border-neutral-800 pb-2">Hal yang Sedang Difokuskan</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {focuses.map(item => (
      <div class="p-6 border-2 border-neutral-200 dark:border-neutral-800 rounded-xl hover:border-purple-400 dark:hover:border-purple-500 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-4 text-purple-600 dark:text-purple-400 group-hover:scale-110 transition-transform">
          <i data-lucide={item.icon} class="w-6 h-6"></i>
        </div>
        <h3 class="font-heading font-bold text-lg mb-2">{item.title}</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
      </div>
    ))}
  </div>
</section>